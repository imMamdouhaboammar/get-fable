        }
      },
      "expected": {
        "suggestion": "check the current official docs",
        "reasonCode": "external-research-required",
        "silent": false
      }
    },
    {
      "id": "spark-holdout-delegate",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "executing",
          "currentSkill": "fable-delegate"
        },
        "openCards": [
          "api",
          "ui",
          "docs"
        ]
      },
      "expected": {
        "suggestion": "delegate the independent cards",
        "reasonCode": "independent-cards-delegation",
        "silent": false
      }
    },
    {
      "id": "spark-holdout-release",
      "category": "holdout",
      "given": {
        "state": {
