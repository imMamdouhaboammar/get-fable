    {
      "id": "spark-holdout-security-functional",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "verifying",
          "currentSkill": "fable-security",
          "mutationGeneration": 5,
          "verifiedGeneration": 4,
          "evidence": [
            {
              "kind": "security",
              "result": "pass"
            }
          ]
        },
        "userIntent": "Repair the functional bug"
      },
      "expected": {
        "suggestion": "verify the repaired behavior",
        "reasonCode": "security-does-not-prove-functional-repair",
        "silent": false
      },
      "forbidden": {
        "suggestion": "check release readiness"
      }
    },
