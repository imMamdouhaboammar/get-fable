          "verifiedGeneration": 3
        }
      },
      "expected": {
        "suggestion": "run the affected tests",
        "reasonCode": "verification-stale-after-mutation",
        "silent": false
      }
    },
    {
      "id": "spark-holdout-tdd-red",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "executing",
          "currentSkill": "fable-tdd",
          "mutationGeneration": 0,
          "verifiedGeneration": -1,
          "evidence": []
        }
      },
      "expected": {
        "suggestion": "write the failing test",
        "reasonCode": "tdd-missing-failing-test",
        "silent": false
      }
    },
    {
      "id": "spark-holdout-review-needed",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "verifying",
          "currentSkill": "fable-review",
          "mutationGeneration": 2,
          "verifiedGeneration": 2,
          "evidence": [
            {
              "kind": "test",
              "result": "pass"
            }
          ]
        }
      },
      "expected": {
        "suggestion": "review the diff",
        "reasonCode": "diff-unreviewed",
        "silent": false
      }
    },
    {
