{
  "schemaVersion": 1,
  "suite": "enterprise-spark-holdout-v1",
  "cases": [
    {
      "id": "spark-holdout-migration-failure",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "executing",
          "failureStreak": 2
        },
        "latestError": "migration failed for the second time"
      },
      "expected": {
        "suggestion": "diagnose the repeated migration failure",
        "reasonCode": "failure-loop-diagnose-required",
        "silent": false
      }
    },
    {
      "id": "spark-holdout-generic-failure",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "executing",
          "failureStreak": 3
        }
      },
      "expected": {
        "suggestion": "diagnose the repeated failure",
        "reasonCode": "failure-loop-diagnose-required",
        "silent": false
      }
    },
    {
      "id": "spark-holdout-css-build",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "verifying",
          "mutationGeneration": 4,
          "verifiedGeneration": 3
        },
        "latestMutationSource": "styles.css"
      },
      "expected": {
        "suggestion": "run the build",
        "reasonCode": "build-verification-stale",
        "silent": false
      }
    },
    {
      "id": "spark-holdout-normal-mutation",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "executing",
