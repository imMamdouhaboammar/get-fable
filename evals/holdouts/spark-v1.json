    },
    {
      "id": "spark-holdout-idle-generic",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "idle"
        },
        "userIntent": "Add a small button"
      },
      "expected": {
        "suggestion": "route the task",
        "reasonCode": "intake-route-task",
        "silent": false
      }
    },
    {
      "id": "spark-holdout-complete-review-stale",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "complete",
          "currentSkill": "fable-review",
          "mutationGeneration": 3,
          "verifiedGeneration": 3
        }
      },
      "expected": {
        "suggestion": null,
        "reasonCode": "scope-complete-silent",
        "silent": true
      },
      "forbidden": {
        "suggestion": "review the diff"
      }
    },
    {
      "id": "spark-holdout-review-typo-done",
      "category": "holdout",
      "given": {
        "state": {
          "phase": "verifying",
          "currentSkill": "fable-review",
          "mutationGeneration": 1,
          "verifiedGeneration": 1,
          "activeCard": "fix documentation typo",
          "evidence": [
            {
              "kind": "review",
              "result": "pass"
            }
          ]
        }
      },
      "expected": {
        "suggestion": null,
        "reasonCode": "silent-no-obvious-move",
        "silent": true
      },
      "forbidden": {
        "suggestion": "fix the review finding"
      }
    },
    {
      "id": "spark-holdout-recover-beats-handoff",
      "category": "holdout",
