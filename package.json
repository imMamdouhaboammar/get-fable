{
  "name": "get-fable",
  "version": "1.3.0",
  "description": "A portable coding lifecycle for AI agents with deterministic routing, durable state, mutation-aware verification, specialized skill packs, lifecycle hooks, and an optional local request proxy.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "get-fable": "bin/get-fable.js"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".chatgpt-plugin/",
    ".gemini-plugin/",
    ".cursor-plugin/",
    ".kimi-plugin/",
    ".opencode-plugin/",
    ".deepseek-plugin/",
    ".kiro-plugin/",
    ".pi-plugin/",
    ".codex/",
    "AGENTS.md",
    "SKILL.md",
    "skills.sh.json",
    "skills/",
    "packs/",
    "registry/",
    "recipes/",
    "policies/",
    "schemas/",
    "agents/",
    "bin/",
    "src/",
    "public/",
    "assets/",
    "prompts/",
    "hooks/",
    "shell/",
    "completions/",
    "Formula/",
    "docs/*.md",
    "docs/architecture/",
    "docs/learning/",
    "templates/",
    "eval/",
    "install.sh",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "bun ./bin/get-fable.js",
    "test": "bun test --timeout 30000",
    "test:coverage": "bun test --timeout 30000 --coverage",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun",
    "check": "bun run check:generated && bun run check:llms && bun run typecheck && bun run test && bun run build",
    "lint": "bun ./bin/get-fable.js lint",
    "serve:web": "bun ./bin/serve-web.js",
    "prepack": "bun run check",
    "generate:catalog": "bun scripts/generate-catalog.ts",
    "check:generated": "bun scripts/generate-catalog.ts --check",
    "generate:llms": "bun scripts/generate-llms-txt.ts",
    "check:llms": "bun scripts/generate-llms-txt.ts --check"
  },
  "keywords": [
    "codex",
    "chatgpt",
    "openai-plugin",
    "agent-skills",
    "claude-code",
    "fable-mode",
    "ai-agent",
    "agent-workflow",
    "antigravity",
    "gemini-cli",
    "agent-discipline",
    "coding-agent",
    "coding-lifecycle",
    "tdd",
    "verification"
  ],
  "author": "Mamdouh Abo Ammar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imMamdouhaboammar/get-fable.git"
  },
  "bugs": {
    "url": "https://github.com/imMamdouhaboammar/get-fable/issues"
  },
  "homepage": "https://github.com/imMamdouhaboammar/get-fable#readme",
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cypress": "15.21.0",
    "typescript": "^5.7.0"
  }
}
