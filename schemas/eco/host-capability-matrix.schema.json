{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fable Eco Host Capability Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_id",
    "detection",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "host_id": {
      "type": "string"
    },
    "detection": {
      "enum": [
        "present",
        "absent",
        "unknown",
        "error"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "supported",
          "unsupported",
          "unknown"
        ]
      }
    }
  }
}
