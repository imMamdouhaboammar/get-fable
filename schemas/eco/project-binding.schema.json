{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fable Eco Project Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "capabilities",
    "policy",
    "hosts",
    "provider_preferences",
    "minimum_contract_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "string"
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_preferences": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "minimum_contract_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
