{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FableToolDefinition",
  "type": "object",
  "required": ["name", "capability", "description", "parameters"],
  "properties": {
    "name": { "type": "string" },
    "capability": { "type": "string" },
    "description": { "type": "string" },
    "adapters": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parameters": {
      "type": "object"
    }
  }
}
