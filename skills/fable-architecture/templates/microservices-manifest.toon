architecture_manifest: {verdict, allow_monolith, scale_score, domain_score, resource_score, composite_score}
  microservices, false, 8.5, 8.0, 8.5, 8.3

communication_standards: {boundary, protocol, transport, http_json_prohibited}
  North-South (Client -> Gateway), REST HTTP/JSON, TLS 1.3 (OpenAPI 3.1), false
  East-West (Service -> Service), gRPC, HTTP/2 + Protobuf, true

services [4]: {name, domain, scenario, language, framework, runtime, role, port, grpc_port}
