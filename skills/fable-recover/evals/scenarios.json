    "expected": {"action": "compare-environment-and-execution-context", "produces": "revised-hypothesis"},
    "forbidden": {"action": "assume-ci-random-and-retry"}
  },
  {
    "id": "fable-recover-flaky-race",
    "description": "Identical test alternates outcomes and needs deterministic timing/order instrumentation",
    "given": {"runs": ["pass", "fail", "pass", "fail"], "mutation": "none"},
    "expected": {"action": "control-or-instrument-nondeterminism", "produces": "revised-hypothesis"},
